LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Google Search grounding needs Search quota on the key (0 = off)
USE_GOOGLE_SEARCH=0
MAX_TURNS=20
# OBK index code reference (not committed, keep next to app.py or set a path)
OBK_BUNDLE_PATH=obk_ref_bundle.json
PUBLIC_BASE_URL=
OBK_MAX_FILE_MB=20
OBK_DOWNLOAD_TTL_HOURS=24
# Groups: answer only /check, and chat when @mentioned (0 = /check only)
GROUP_CHAT_ON_MENTION=1
GROUP_FILE_TTL_MINUTES=60
# LINE user IDs (comma-separated) of the people responsible for Vicky.
# Vicky only serves groups that include one of them, and only they can chat 1:1.
# Find yours: LINE Developers Console > Basic settings > Your user ID, or send /myid to Vicky.
ADMIN_USER_IDS=
# Optional: lets run_vicky.ipynb open an ngrok tunnel and set the LINE webhook URL
NGROK_AUTHTOKEN=
